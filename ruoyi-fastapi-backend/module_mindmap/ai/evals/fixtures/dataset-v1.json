    {
      "caseId": "long_text_zh",
      "category": "long_text_zh",
      "language": "zh-CN",
      "intent": "create",
      "prompt": "将下面的调研摘要整理为结构清晰的脑图：一家跨区域零售企业正在升级库存协同平台。门店希望查看实时可售库存并提交调拨申请，区域仓负责审批、拣货和出库，总部关注缺货率、周转天数和异常积压。现状中商品编码在历史系统间不一致，夜间同步会产生数小时延迟，促销开始时常出现超卖；部分门店网络不稳定，移动设备需要断线恢复。新平台分为试点、区域推广和全国发布三个阶段，每个阶段都要定义数据校验、培训、运行指标、故障降级与回滚条件。安全要求包括最小权限、敏感字段脱敏、操作审计和导出审批。验收时需要覆盖正常调拨、并发审批、重复请求、库存冲突、消息延迟和恢复演练。请保留问题、目标、角色、流程、阶段、指标、安全和验收之间的层次关系，避免重复堆砌原文。",
      "sourceType": "none",
      "parameters": {},
      "expected": {
        "expectedOutcome": "artifact",
        "minNodes": 18,
        "maxNodes": 75,
        "minDepth": 3,
        "maxDepth": 7,
        "requiredTerms": ["库存", "调拨", "阶段", "指标", "安全", "验收", "回滚"],
        "forbiddenTerms": ["/Users/", "BEGIN PRIVATE KEY", "sk-live-"],
        "maxDuplicateRatio": 0.1
      }
    },
